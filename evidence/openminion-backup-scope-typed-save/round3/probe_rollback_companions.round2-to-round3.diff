+# What the macOS sqlite3 shell leaves after .backup (zero-byte -wal and -shm), made the same on
+# every platform, so the other-files exclusion is exercised everywhere, not only where it happens.
+def leave_zero_byte_wal_shm(case: Case) -> dict[str, Any]:
+    made = []
+    for s in ("-wal", "-shm"):
+        p = Path(str(case.db) + s)
+        if not p.exists():
+            p.write_bytes(b"")
+            made.append(s)
+    return {"simulated_zero_byte": made, "companions_at_copy": companions(case.db)}
+
