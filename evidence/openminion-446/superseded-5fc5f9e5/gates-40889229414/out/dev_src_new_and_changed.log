                    "normalized_key": "user_preference:indentation",
                    "title": "Indentation",
                    "content": user_message,
                    "tags": [],
                    "confidence": 0.7,
                }
            ]
    
        def failing_write(**_kwargs: object) -> dict[str, object]:
            raise StoreWriteError("memory store write failed")
    
